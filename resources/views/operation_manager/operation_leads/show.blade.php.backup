                        <div class="form-group mb-3">
                            <label for="payment_received">Amount Received</label>
                            <input type="number" step="0.01" class="form-control" id="payment_received" name="payment_received" onchange="calculateNetAmount()">
                        </div>
                        <div class="form-group mb-3">
                            <label for="refund_amount">Refund Amount</label>
                            <input type="number" step="0.01" class="form-control" id="refund_amount" name="refund_amount" value="0" onchange="calculateNetAmount()">
                        </div>
                        <div class="form-group mb-3">
                            <label for="net_amount">Net Amount</label>
                            <input type="number" step="0.01" class="form-control" id="net_amount" name="net_amount" readonly style="background-color: #f8f9fa;">
                        </div>
                        <div class="form-group mb-3">
                            <label for="utr_number">UTR Number</label>
                            <input type="text" class="form-control" id="utr_number" name="utr_number" placeholder="Enter UTR number">
                        </div>
                        <div class="form-group mb-3">
                            <label for="received_date">Received Date</label>
                            <input type="datetime-local" class="form-control" id="received_date" name="received_date">
                        </div>
                        <div class="form-group mb-3">
                            <label for="from_date_time">From Date & Time</label>
                            <input type="datetime-local" class="form-control" id="from_date_time" name="from_date_time" onchange="calculateOutstandingPayment()">
                        </div>
                        <div class="form-group mb-3">
                            <label for="to_date_time">To Date & Time</label>
                            <input type="datetime-local" class="form-control" id="to_date_time" name="to_date_time" onchange="calculateOutstandingPayment()">
                        </div>
                        <div class="form-group mb-3">
                            <label for="screenshot">Screenshot <span class="text-danger">*</span></label>
                            <input type="file" class="form-control" id="screenshot" name="screenshot" required accept="image/*,application/pdf">
                            <small class="text-muted">Please upload a screenshot of the payment transaction (required)</small>
                        </div>
                        <div class="form-group mb-3">
                            <label for="outstanding_payment">Outstanding Payment</label>
                            <input type="number" step="0.01" class="form-control" id="outstanding_payment" name="outstanding_payment" readonly style="background-color: #f8f9fa;">
                            <small class="text-muted">Automatically calculated based on Closed Rate and payments received</small>
                        </div>
                        <div class="form-group mb-3">
                            <label for="remark">Remark</label>
                            <textarea class="form-control" id="remark" name="remark" rows="3" placeholder="Enter any additional remarks..."></textarea>
                        </div>
