        // Calculate net amount for Add Payment form
        function calculateNetAmount() {
            const paymentReceived = parseFloat(document.getElementById('payment_received').value) || 0;
            const refundAmount = parseFloat(document.getElementById('refund_amount').value) || 0;
            const netAmount = paymentReceived - refundAmount;

            document.getElementById('net_amount').value = netAmount.toFixed(2);

            // Calculate outstanding payment
            calculateOutstandingPayment();
        }

        // Calculate outstanding payment for Add Payment form
        function calculateOutstandingPayment() {
            const closedRate = parseFloat('{{ $lead->closed_rate ?: 0 }}') || 0; // This is now per day rate
            const fromDate = document.getElementById('from_date_time').value;
            const toDate = document.getElementById('to_date_time').value;
            const netAmount = parseFloat(document.getElementById('net_amount').value) || 0;

            console.log('Debug - calculateOutstandingPayment:', {
                closedRate: closedRate,
                fromDate: fromDate,
                toDate: toDate,
                netAmount: netAmount
            });

            if (fromDate && toDate && netAmount > 0) {
                const startDate = new Date(fromDate);
                const endDate = new Date(toDate);

                // Calculate work days (inclusive of both start and end dates)
                const timeDiff = endDate.getTime() - startDate.getTime();
                const workDays = Math.ceil(timeDiff / (1000 * 3600 * 24)) + 1; // +1 for inclusive

                // Calculate total expected amount for this payment period
                const totalExpectedAmount = workDays * closedRate;

                // Calculate outstanding payment for this specific payment detail
                const outstandingAmount = netAmount - totalExpectedAmount;

                console.log('Debug - Calculation details:', {
                    startDate: startDate,
                    endDate: endDate,
                    timeDiff: timeDiff,
                    workDays: workDays,
                    totalExpectedAmount: totalExpectedAmount,
                    netAmount: netAmount,
                    outstandingAmount: outstandingAmount
                });

                document.getElementById('outstanding_payment').value = outstandingAmount.toFixed(2);
            } else {
                document.getElementById('outstanding_payment').value = '0.00';
            }
        }

        // Calculate net amount for Edit Payment form
        function calculateEditNetAmount() {
            const paymentReceived = parseFloat(document.getElementById('edit_payment_received').value) || 0;
            const refundAmount = parseFloat(document.getElementById('edit_refund_amount').value) || 0;
            const netAmount = paymentReceived - refundAmount;

            document.getElementById('edit_net_amount').value = netAmount.toFixed(2);

            // Calculate outstanding payment for edit form
            calculateEditOutstandingPayment();
        }

        // Calculate outstanding payment for Edit Payment form
        function calculateEditOutstandingPayment() {
            const closedRate = parseFloat('{{ $lead->closed_rate ?: 0 }}') || 0; // This is now per day rate
            const fromDate = document.getElementById('edit_from_date_time').value;
            const toDate = document.getElementById('edit_to_date_time').value;
            const netAmount = parseFloat(document.getElementById('edit_net_amount').value) || 0;

            if (fromDate && toDate && netAmount > 0) {
                const startDate = new Date(fromDate);
                const endDate = new Date(toDate);

                // Calculate work days (inclusive of both start and end dates)
                const timeDiff = endDate.getTime() - startDate.getTime();
                const workDays = Math.ceil(timeDiff / (1000 * 3600 * 24)) + 1; // +1 for inclusive

                // Calculate total expected amount for this payment period
                const totalExpectedAmount = workDays * closedRate;

                // Calculate outstanding payment for this specific payment detail
                const outstandingAmount = netAmount - totalExpectedAmount;

                document.getElementById('edit_outstanding_payment').value = outstandingAmount.toFixed(2);
            } else {
                document.getElementById('edit_outstanding_payment').value = '0.00';
            }
        }

        // Initialize net amount calculation when modals open
        document.addEventListener('DOMContentLoaded', function() {
            // Add Payment Modal
            const addPaymentModal = document.getElementById('addPaymentDetailModal');
            if (addPaymentModal) {
                addPaymentModal.addEventListener('shown.bs.modal', function() {
                    calculateNetAmount();
                });
            }

            // Edit Payment Modal
            const editPaymentModal = document.getElementById('editPaymentDetailModal');
            if (editPaymentModal) {
                editPaymentModal.addEventListener('shown.bs.modal', function() {
                    calculateEditNetAmount();
                });
            }

            // Add Deployment Modal
            const addDeploymentModal = document.getElementById('addDeploymentDetailModal');
            if (addDeploymentModal) {
                addDeploymentModal.addEventListener('shown.bs.modal', function() {
                    calculateVendorPayment();
                });
            }

            // Edit Deployment Modal
            const editDeploymentModal = document.getElementById('editDeploymentDetailModal');
            if (editDeploymentModal) {
                editDeploymentModal.addEventListener('shown.bs.modal', function() {
                    calculateEditVendorPayment();
                });
            }

            // Add event listeners for outstanding payment calculation
            document.getElementById('payment_received').addEventListener('input', calculateOutstandingPayment);
            document.getElementById('refund_amount').addEventListener('input', calculateOutstandingPayment);
            document.getElementById('from_date_time').addEventListener('change', calculateOutstandingPayment);
            document.getElementById('to_date_time').addEventListener('change', calculateOutstandingPayment);
            document.getElementById('edit_payment_received').addEventListener('input', calculateEditOutstandingPayment);
            document.getElementById('edit_refund_amount').addEventListener('input', calculateEditOutstandingPayment);
            document.getElementById('edit_from_date_time').addEventListener('change', calculateEditOutstandingPayment);
            document.getElementById('edit_to_date_time').addEventListener('change', calculateEditOutstandingPayment);

            // Add event listeners for vendor payment calculation
            document.getElementById('deployment_from_date').addEventListener('change', calculateVendorPayment);
            document.getElementById('deployment_to_date').addEventListener('change', calculateVendorPayment);
            document.getElementById('vendor_rate_per_day').addEventListener('input', calculateVendorPayment);
            document.getElementById('edit_deployment_from_date').addEventListener('change', calculateEditVendorPayment);
            document.getElementById('edit_deployment_to_date').addEventListener('change', calculateEditVendorPayment);
            document.getElementById('edit_vendor_rate_per_day').addEventListener('input', calculateEditVendorPayment);
        });

        // Calculate vendor payment for Add Deployment form
        function calculateVendorPayment() {
            const fromDate = document.getElementById('deployment_from_date').value;
            const toDate = document.getElementById('deployment_to_date').value;
            const ratePerDay = parseFloat(document.getElementById('vendor_rate_per_day').value) || 0;

            if (fromDate && toDate && ratePerDay > 0) {
                const startDate = new Date(fromDate);
                const endDate = new Date(toDate);

                // Calculate work days (inclusive of both start and end dates)
                const timeDiff = endDate.getTime() - startDate.getTime();
                const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24)) + 1; // +1 for inclusive

                const vendorPayment = daysDiff * ratePerDay;
                document.getElementById('vendor_payment').value = vendorPayment.toFixed(2);
            } else {
                document.getElementById('vendor_payment').value = '0.00';
            }
        }

        // Calculate vendor payment for Edit Deployment form
        function calculateEditVendorPayment() {
            const fromDate = document.getElementById('edit_deployment_from_date').value;
            const toDate = document.getElementById('edit_deployment_to_date').value;
            const ratePerDay = parseFloat(document.getElementById('edit_vendor_rate_per_day').value) || 0;

            if (fromDate && toDate && ratePerDay > 0) {
                const startDate = new Date(fromDate);
                const endDate = new Date(toDate);

                // Calculate work days (inclusive of both start and end dates)
                const timeDiff = endDate.getTime() - startDate.getTime();
                const daysDiff = Math.ceil(timeDiff / (1000 * 3600 * 24)) + 1; // +1 for inclusive

                const vendorPayment = daysDiff * ratePerDay;
                document.getElementById('edit_vendor_payment').value = vendorPayment.toFixed(2);
            } else {
                document.getElementById('edit_vendor_payment').value = '0.00';
            }
        }

        // View Payment Detail Function
        function viewPaymentDetail(id) {
            fetch(`/operation-manager/operation-leads/payment/${id}/edit`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const payment = data.payment;

                        // Calculate net amount
                        const paymentReceived = parseFloat(payment.payment_received) || 0;
                        const refundAmount = parseFloat(payment.refund_amount) || 0;
                        const netAmount = paymentReceived - refundAmount;

                        // Populate view modal
                        document.getElementById('view_payment_received').textContent = `₹${paymentReceived.toFixed(2)}`;
                        document.getElementById('view_refund_amount').textContent = `₹${refundAmount.toFixed(2)}`;
                        document.getElementById('view_net_amount').textContent = `₹${netAmount.toFixed(2)}`;
                        document.getElementById('view_utr_number').textContent = payment.utr_number || 'N/A';
                        document.getElementById('view_received_date').textContent = payment.received_date ? new Date(payment.received_date).toLocaleString('en-IN') : 'N/A';
                        document.getElementById('view_from_date_time').textContent = payment.from_date_time ? new Date(payment.from_date_time).toLocaleString('en-IN') : 'N/A';
                        document.getElementById('view_to_date_time').textContent = payment.to_date_time ? new Date(payment.to_date_time).toLocaleString('en-IN') : 'N/A';
                        const outstanding = payment.outstanding_payment ? parseFloat(payment.outstanding_payment) : 0;
                        const outstandingColor = outstanding > 0 ? 'text-success' : (outstanding < 0 ? 'text-danger' : 'text-dark');
                        document.getElementById('view_outstanding_payment').textContent = `₹${outstanding.toFixed(2)}`;
                        document.getElementById('view_outstanding_payment').className = outstandingColor;
                        document.getElementById('view_remark').textContent = payment.remark || 'N/A';

                        // Handle screenshot
                        const screenshotDiv = document.getElementById('view_screenshot');
                        if (payment.screenshot) {
                            screenshotDiv.innerHTML = `<a href="/storage/${payment.screenshot}" target="_blank" class="btn btn-sm btn-info"><i class="fa fa-image"></i> View Screenshot</a>`;
                        } else {
                            screenshotDiv.textContent = 'N/A';
                        }

                        // Show modal
                        new bootstrap.Modal(document.getElementById('viewPaymentDetailModal')).show();
                }
            })
            .catch(error => {
                console.error('Error:', error);
                    alert('Error loading payment detail');
                });
        }

        // View Deployment Detail Function
        function viewDeploymentDetail(id) {
            fetch(`/operation-manager/operation-leads/deployment/${id}/edit`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const deployment = data.deployment;

                        // Populate view modal
                        document.getElementById('view_deployment_date').textContent = deployment.deployment_date ? new Date(deployment.deployment_date).toLocaleString('en-IN') : 'N/A';
                        document.getElementById('view_deployment_from_date').textContent = deployment.deployment_from_date ? new Date(deployment.deployment_from_date).toLocaleString('en-IN') : 'N/A';
                        document.getElementById('view_deployment_to_date').textContent = deployment.deployment_to_date ? new Date(deployment.deployment_to_date).toLocaleString('en-IN') : 'N/A';
                        document.getElementById('view_deployment_status').textContent = deployment.deployment_status || 'N/A';
                        document.getElementById('view_duty_hours').textContent = deployment.duty_hours || 'N/A';
                        document.getElementById('view_vendor').textContent = deployment.vendor ? deployment.vendor.name : 'N/A';
                        document.getElementById('view_staff_name').textContent = deployment.staff_name || 'N/A';
                        document.getElementById('view_staff_number').textContent = deployment.staff_number || 'N/A';
                        document.getElementById('view_payment_term').textContent = deployment.payment_term || 'N/A';
                        document.getElementById('view_vendor_rate_per_day').textContent = deployment.vendor_rate_per_day ? `₹${parseFloat(deployment.vendor_rate_per_day).toFixed(2)}` : 'N/A';
                        document.getElementById('view_vendor_payment').textContent = deployment.vendor_payment ? `₹${parseFloat(deployment.vendor_payment).toFixed(2)}` : 'N/A';
                        document.getElementById('view_deployment_remark').textContent = deployment.remark || 'N/A';

                        // Show modal
                        new bootstrap.Modal(document.getElementById('viewDeploymentDetailModal')).show();
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error loading deployment detail');
                });
        }

        // Function to toggle status remark fields in edit modal
        function toggleStatusRemark() {
            var statusSelect = document.querySelector('select[name="status"]');
            var priceIssueRemarkGroup = document.getElementById('edit_price_issue_remark_group');
            var inactiveRemarkGroup = document.getElementById('edit_inactive_remark_group');
            var closedRemarkGroup = document.getElementById('edit_closed_remark_group');
            if (statusSelect) {
                var status = statusSelect.value;
                if (priceIssueRemarkGroup) {
                    priceIssueRemarkGroup.classList.toggle('d-none', status !== 'price issue');
                }
                if (inactiveRemarkGroup) {
                    inactiveRemarkGroup.classList.toggle('d-none', status !== 'inactive');
                }
                if (closedRemarkGroup) {
                    closedRemarkGroup.classList.toggle('d-none', status !== 'closed');
                }
            }
        }

        // Function to toggle query remark field in edit modal
        function toggleQueryRemark() {
            var querySelect = document.querySelector('select[name="query"]');
            var queryRemarkGroup = document.getElementById('edit_query_remark_group');
            if (querySelect && queryRemarkGroup) {
                var query = querySelect.value;
                // Show query remark field for any selected query
                queryRemarkGroup.classList.toggle('d-none', !query || query === '');
            }
        }

        // Function to toggle status remark field when edit modal opens
        function toggleEditStatusRemark() {
            setTimeout(function() {
                toggleStatusRemark();
            }, 100);
        }

        // Load filtered vendors for deployment forms
        function loadFilteredVendors() {
            const leadLocation = '{{ $lead->location }}';
            const leadService = '{{ $lead->query }}';

            // Load vendors for add deployment form
            fetch(`/operation-manager/operation-leads/filtered-vendors?location=${encodeURIComponent(leadLocation)}&service=${encodeURIComponent(leadService)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const vendorSelect = document.getElementById('vendor_id');
                        if (vendorSelect) {
                            vendorSelect.innerHTML = '<option value="">Select Vendor</option>';
                            data.vendors.forEach(vendor => {
                                const option = document.createElement('option');
                                option.value = vendor.id;
                                option.textContent = vendor.name;
                                if (vendor.is_freelance) {
                                    option.textContent += ' (Freelance)';
                                }
                                vendorSelect.appendChild(option);
                            });
                        }
                    }
                })
                .catch(error => {
                    console.error('Error loading vendors:', error);
                    const vendorSelect = document.getElementById('vendor_id');
                    if (vendorSelect) {
                        vendorSelect.innerHTML = '<option value="">Error loading vendors</option>';
                    }
                });

            // Load vendors for edit deployment form
            fetch(`/operation-manager/operation-leads/filtered-vendors?location=${encodeURIComponent(leadLocation)}&service=${encodeURIComponent(leadService)}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const editVendorSelect = document.getElementById('edit_vendor_id');
                        if (editVendorSelect) {
                            editVendorSelect.innerHTML = '<option value="">Select Vendor</option>';
                            data.vendors.forEach(vendor => {
                                const option = document.createElement('option');
                                option.value = vendor.id;
                                option.textContent = vendor.name;
                                if (vendor.is_freelance) {
                                    option.textContent += ' (Freelance)';
                                }
                                editVendorSelect.appendChild(option);
                            });
                        }
                    }
                })
                .catch(error => {
                    console.error('Error loading vendors:', error);
                    const editVendorSelect = document.getElementById('edit_vendor_id');
                    if (editVendorSelect) {
                        editVendorSelect.innerHTML = '<option value="">Error loading vendors</option>';
                    }
                });
        }

        // Call loadFilteredVendors when the page loads
        document.addEventListener('DOMContentLoaded', function() {
            loadFilteredVendors();
        });

        // Function to toggle stopped remark field in payment modal
        function toggleStoppedRemark() {
            var ongoingStoppedSelect = document.getElementById('ongoing_stopped');
            var stoppedRemarkGroup = document.getElementById('stopped_remark_group');
            if (ongoingStoppedSelect && stoppedRemarkGroup) {
                var status = ongoingStoppedSelect.value;
                stoppedRemarkGroup.classList.toggle('d-none', status !== 'stopped');
            }
        }

        // Toggle Verify Payment Function
        function toggleVerifyPayment(deploymentId, isChecked) {
            $.ajax({
                url: `{{ url('operation-manager/operation-leads/deployment') }}/${deploymentId}/toggle-verify-payment`,
                type: 'POST',
                data: {
                    verify_payment: isChecked,
                    _token: $('meta[name="csrf-token"]').attr('content')
                },
                success: function(response) {
                    if (response.success) {
                        toastr.success(response.message);
                    } else {
                        toastr.error(response.message || 'Failed to update payment verification status');
                        // Revert checkbox state on error
                        $(`input[data-deployment-id="${deploymentId}"]`).prop('checked', !isChecked);
                    }
                },
                error: function(xhr) {
                    console.error('Error:', xhr);
                    toastr.error('Error updating payment verification status. Please try again.');
                    // Revert checkbox state on error
                    $(`input[data-deployment-id="${deploymentId}"]`).prop('checked', !isChecked);
                }
            });
        }
    </script>
@endsection
