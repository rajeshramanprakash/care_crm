        // Add Payment Detail Form Submission
        $('#addPaymentDetailForm').on('submit', function(e) {
            e.preventDefault();
            
            // Check if screenshot is uploaded
            const screenshotInput = document.getElementById('screenshot');
            if (!screenshotInput.files || screenshotInput.files.length === 0) {
                alert('Please upload a payment screenshot. This is required for verification.');
                screenshotInput.focus();
                return false;
            }
            
            var formData = new FormData(this);

            $.ajax({
                url: "{{ route('operation-manager.operation_leads.payment.store', $lead->id) }}",
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    toastr.success('Payment detail added successfully');
                    $('#addPaymentDetailModal').modal('hide');
                    location.reload();
                },
                error: function(xhr) {
                    if (xhr.status === 422 && xhr.responseJSON && xhr.responseJSON.message) {
                        alert('Validation Error: ' + xhr.responseJSON.message);
                    } else if (xhr.responseJSON && xhr.responseJSON.errors) {
                        let errorMsg = 'Validation Errors:\n';
                        Object.keys(xhr.responseJSON.errors).forEach(function(key) {
                            errorMsg += '- ' + xhr.responseJSON.errors[key][0] + '\n';
                        });
                        alert(errorMsg);
                    } else {
                        alert('Error adding payment detail');
                    }
                }
            });
        });

        // Edit Payment Detail Form Submission
        $('#editPaymentDetailForm').on('submit', function(e) {
            e.preventDefault();
            var formData = new FormData(this);
            formData.append('_token', $('meta[name="csrf-token"]').attr('content'));
            formData.append('_method', 'PUT');

            console.log('Submitting form to:', $(this).attr('action'));
            console.log('Form data:', Object.fromEntries(formData));

            $.ajax({
                url: $(this).attr('action'),
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    console.log('Success response:', response);
                    $('#editPaymentDetailModal').modal('hide');
                    location.reload();
                },
                error: function(xhr, status, error) {
                    console.error('Error details:', {
                        status: xhr.status,
                        statusText: xhr.statusText,
                        responseText: xhr.responseText,
                        error: error
                    });

                    if (xhr.status === 422 && xhr.responseJSON && xhr.responseJSON.message) {
                        alert('Validation Error: ' + xhr.responseJSON.message);
                    } else if (xhr.responseJSON && xhr.responseJSON.message) {
                        alert('Error: ' + xhr.responseJSON.message);
                    } else {
                        alert('Error updating payment detail. Status: ' + xhr.status);
                    }
                }
            });
        });

        // Deployment Details Form Handling
        document.getElementById('addDeploymentDetailForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const formData = new FormData(this);
            formData.append('operation_lead_id', '{{ $lead->id }}');

            console.log('Submitting add deployment form to:', '{{ route("operation-manager.operation_leads.deployment.store", $lead->id) }}');
            console.log('Form data:', Object.fromEntries(formData));

            fetch('{{ route("operation-manager.operation_leads.deployment.store", $lead->id) }}', {
                method: 'POST',
                body: formData,
                headers: {
                    'X-CSRF-TOKEN': '{{ csrf_token() }}'
                }
            })
            .then(response => {
                console.log('Response status:', response.status);
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                return response.json();
            })
            .then(data => {
                console.log('Response data:', data);
                if (data.success) {
                    toastr.success(data.message);
                    $('#addDeploymentDetailModal').modal('hide');
                    location.reload();
                } else {
                    toastr.error(data.message || 'Failed to add deployment detail');
                }
            })
            .catch(error => {
                console.error('Error details:', {
                    message: error.message,
                    stack: error.stack
                });
                toastr.error('An error occurred while adding deployment detail: ' + error.message);
            });
        });

        function editDeploymentDetail(id) {
            console.log('Fetching deployment detail for ID:', id);
            fetch(`{{ url('operation-manager/operation-leads/deployment') }}/${id}/edit`)
                .then(response => {
                    console.log('Response status:', response.status);
                    if (!response.ok) {
                        throw new Error(`HTTP error! status: ${response.status}`);
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Deployment data received:', data);
                    if (data.success) {
                        const deployment = data.deployment;
                        const form = document.getElementById('editDeploymentDetailForm');
                        form.action = `{{ url('operation-manager/operation-leads/deployment') }}/${id}`;

                        // Format dates for datetime-local input with null checks
                        let formattedDeploymentDate = '';
                        let formattedFromDate = '';
                        let formattedToDate = '';

                        if (deployment.deployment_date) {
                            try {
                        const deploymentDate = new Date(deployment.deployment_date);
                                if (!isNaN(deploymentDate.getTime())) {
                                    formattedDeploymentDate = deploymentDate.toISOString().slice(0, 16);
                                }
                            } catch (e) {
                                console.log('Invalid deployment_date:', deployment.deployment_date);
                            }
                        }

                        if (deployment.deployment_from_date) {
                            try {
                                const fromDate = new Date(deployment.deployment_from_date);
                                if (!isNaN(fromDate.getTime())) {
                                    formattedFromDate = fromDate.toISOString().slice(0, 16);
                                }
                            } catch (e) {
                                console.log('Invalid deployment_from_date:', deployment.deployment_from_date);
                            }
                        }

                        if (deployment.deployment_to_date) {
                            try {
                                const toDate = new Date(deployment.deployment_to_date);
                                if (!isNaN(toDate.getTime())) {
                                    formattedToDate = toDate.toISOString().slice(0, 16);
                                }
                            } catch (e) {
                                console.log('Invalid deployment_to_date:', deployment.deployment_to_date);
                            }
                        }

                        document.getElementById('edit_deployment_date').value = formattedDeploymentDate;
                        document.getElementById('edit_deployment_from_date').value = formattedFromDate;
                        document.getElementById('edit_deployment_to_date').value = formattedToDate;
                        document.getElementById('edit_deployment_status').value = deployment.deployment_status || '';
                        document.getElementById('edit_duty_hours').value = deployment.duty_hours || '';
                        document.getElementById('edit_vendor_id').value = deployment.vendor_id || '';
                        document.getElementById('edit_staff_name').value = deployment.staff_name || '';
                        document.getElementById('edit_staff_number').value = deployment.staff_number || '';
                        document.getElementById('edit_payment_term').value = deployment.payment_term || '';
                        document.getElementById('edit_vendor_rate_per_day').value = deployment.vendor_rate_per_day || '';
                        document.getElementById('edit_remark').value = deployment.remark || '';

                        // Set verify payment checkbox
                        document.getElementById('edit_verify_payment').checked = deployment.verify_payment || false;

                        // Calculate vendor payment after populating fields
                        calculateEditVendorPayment();

                        $('#editDeploymentDetailModal').modal('show');
                    } else {
                        toastr.error(data.message || 'Failed to load deployment detail');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    toastr.error('An error occurred while fetching deployment detail');
                });
        }

