APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# APP_URL=https://glossify.anohim.com/
APP_URL=http://localhost:8000
# Must match the URL where Laravel is reachable in the browser (include port). Easebuzz return + careweb API use this.
# Optional: only if return URL must differ from APP_URL (careweb reads this too).
# CARECRM_PUBLIC_URL=http://127.0.0.1:8000

# Google Maps — server-side only (CareCRM proxies Places/Geocoding for CareWeb; do NOT restrict by HTTP referrer).
# Enable in Google Cloud: Places API (New), Geocoding API. Application restriction: None or IP (server).
GOOGLE_MAPS_API_KEY=

# CareWeb consultation — “Call RM” dials this IVR (not executive personal mobile)
CONSULTATION_WEBSITE_IVR_PHONE=7666426664

# --- Website consultation / Easebuzz ---
# TEST:  EASEBUZZ_BASE_URL=https://testpay.easebuzz.in/  + test KEY/SALT from Easebuzz sandbox
# LIVE:  EASEBUZZ_BASE_URL=https://pay.easebuzz.in/     + production KEY/SALT (test keys fail on live URL)
# Return URL = CARECRM_PUBLIC_URL or APP_URL — must be public HTTPS in production (whitelisted in Easebuzz dashboard)
# CARECRM_PUBLIC_URL=https://crm.carelixhealthcare.com
EASEBUZZ_KEY=
EASEBUZZ_SALT=
EASEBUZZ_BASE_URL=https://testpay.easebuzz.in/
EASEBUZZ_PLACEHOLDER_EMAIL=payments@example.com

# --- CRM EasyCollect payment links (Admin / Sales / Operation sidebar) ---
# Demo (default): test dashboard + EASEBUZZ_KEY_DEMO / EASEBUZZ_SALT_DEMO
# Live: EASEBUZZ_EASYCOLLECT_DEMO=false + EASEBUZZ_KEY / EASEBUZZ_SALT + optional EASEBUZZ_EASYCOLLECT_BASE_URL=https://dashboard.easebuzz.in
EASEBUZZ_EASYCOLLECT_DEMO=true
EASEBUZZ_KEY_DEMO=
EASEBUZZ_SALT_DEMO=
# EASEBUZZ_EASYCOLLECT_BASE_URL=https://testdashboard.easebuzz.in
EASEBUZZ_EASYCOLLECT_LINK_DAYS=7
# Use "stack" (file log) when the log path is writable.
# Read-only filesystem / cannot create storage/logs:
#   Option A: LOG_CHANNEL=errorlog  (PHP error log; no file under storage)
#   Option B: LOG_FILE_PATH=/path/writable/laravel.log
# If neither is set, config/logging.php falls back to sys_get_temp_dir() automatically.
LOG_CHANNEL=stack
# LOG_FILE_PATH=/tmp/laravel.log
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=carelix_crm
DB_PASSWORD=Zmb7edtCFrjyRF3Z

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

