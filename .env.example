# --- Leegality eSign (Doctor agreements) ---
LEEGALITY_AUTH_TOKEN=
LEEGALITY_BASE_URL=https://app1.leegality.com/api
# Published Workflow ID from Leegality dashboard (required)
LEEGALITY_PROFILE_ID=
# Optional HMAC salt for webhook MAC verification
LEEGALITY_PRIVATE_SALT=
LEEGALITY_VERIFY_MAC=false
# true = do not attach PDF (use template workflow document only)
LEEGALITY_TEMPLATE_ONLY=false
# Optional static PDF path under storage/app or absolute path
# LEEGALITY_AGREEMENT_PDF_PATH=leegality/doctor-agreement.pdf
